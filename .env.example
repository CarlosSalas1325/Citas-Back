# This file is a TEMPLATE and is committed to git. Never put real credentials here —
# copy it to .env (which is gitignored) and fill the real values there.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=sistema_citas
# Production (Supabase): use the POOLER host, not the direct one — db.<ref>.supabase.co is
# IPv6-only and fails with ENOTFOUND on most networks.
#   Session pooler     :5432  -> migrations and general use
#   Transaction pooler :6543  -> app runtime when you need more concurrency
# The username must be postgres.<your-project-ref>, and any '@' in the password has to be
# percent-encoded as %40.
# Get it from: Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres


# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Backend
BACKEND_PORT=3000
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000


# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sign-In. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and paste the client id here AND in the
# frontend's VITE_GOOGLE_CLIENT_ID — both must be the same value.
# The secret stays server-side only; it must never reach the frontend bundle.
# Authorized JavaScript origin for local dev: http://localhost:5173
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# PagoKit — Stripe (platform billing: businesses subscribe to this SaaS)
# Rule 8: test-mode keys only in this file. Live keys go in your deploy platform's
# secret store — see PAGOKIT_PRODUCTION_CHECKLIST.md. NEVER put sk_live_/whsec_ here.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_test_publishable_key
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhook/stripe`
# and copy the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_local_or_dashboard_signing_secret

# Stripe Price ID(s) for the platform subscription plan(s) (Dashboard -> Product catalog).
# Must be a PRICE id (price_...), not a product id (prod_...).
STRIPE_DEFAULT_PRICE_ID=price_replace_with_your_default_plan_price_id
# Optional comma-separated allow-list. If set, checkout rejects any priceId not listed here
# (defends against a client sending an arbitrary/expensive priceId).
STRIPE_ALLOWED_PRICE_IDS=price_replace_with_your_default_plan_price_id

# Where to send the business admin after Stripe Checkout / Billing Portal
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing
